{
  "id": "ytmusic",
  "name": "YouTube Music",
  "version": "0.5.18",
  "apiVersion": 8,
  "entry": "plugin.js",
  "description": "YouTube Music con interfaz de exploración por carruseles, búsqueda limpia, Playlist IA y biblioteca personal.",
  "author": "JuanDEVYT",
  "creator": "JuandreXter",
  "homepage": "https://github.com/JuanDEVYT/YTMusic_plugin",
  "recommends": ["kinotvapp/kino-plugin-lyrics-ytmusic", "kinotvapp/kino-plugin-lyrics-lrclib"],
  "discoverable": false,
  "hosts": [
    "music.youtube.com",
    "www.youtube.com",
    "accounts.google.com",
    "accounts.youtube.com",
    "*.googlevideo.com"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "scopedSearch",
    "download",
    "migrate"
  ],
  "color": "#FF0050",
  "icon": "icon.png",
  "section": {
    "label": "YT Music"
  },
  "theme": {
    "accent": "#FF0050",
    "onAccent": "#000000",
    "background": "#0A0A0A",
    "surface": "#1C1C1C",
    "highlight": "#F1F1F1"
  },
  "debug": false,
  "telemetry": true,
  "settings": [
    {
      "key": "about",
      "label": "YouTube Music",
      "type": "section",
      "hint": "Pestañas Para ti, Explorar, Tendencias y Biblioteca; géneros en Categorías."
    },
    {
      "key": "account",
      "label": "Tu cuenta de YouTube Music",
      "type": "section",
      "hint": "Opcional. Sin sesión usas YouTube Music como invitado. Mira el README."
    },
    {
      "key": "cookieA",
      "label": "Cookies (parte 1)",
      "type": "password",
      "hint": "Primeros 500 caracteres"
    },
    {
      "key": "cookieB",
      "label": "Cookies (parte 2)",
      "type": "password",
      "hint": "Siguientes 500 caracteres, si hacen falta"
    },
    {
      "key": "cookieC",
      "label": "Cookies (parte 3)",
      "type": "password",
      "hint": "Siguientes 500 caracteres, si hacen falta"
    },
    {
      "key": "cookieD",
      "label": "Cookies (parte 4)",
      "type": "password",
      "hint": "Resto (hasta 500 más), si hace falta"
    },
    {
      "key": "linked",
      "label": "Estado de la sesión",
      "type": "status"
    },
    {
      "key": "logout",
      "label": "Cerrar sesión",
      "type": "action",
      "confirm": "¿Olvidar las cookies guardadas en todos tus aparatos?"
    },
    {
      "key": "playback",
      "label": "Reproducción",
      "type": "section"
    },
    {
      "key": "quality",
      "label": "Formato de audio",
      "type": "select",
      "default": "aac",
      "options": [
        {
          "value": "aac",
          "label": "AAC (más compatible)"
        },
        {
          "value": "opus",
          "label": "Opus (más calidad)"
        }
      ]
    },
    {
      "key": "method",
      "label": "Método de reproducción",
      "type": "select",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automático (recomendado)"
        },
        {
          "value": "browser",
          "label": "Navegador oculto (experimental)"
        }
      ]
    },
    {
      "key": "audio8d",
      "label": "Audio 8D",
      "type": "toggle",
      "default": false,
      "hint": "Usa la versión 8D si existe; en Servidor alternas con el audio original"
    },
    {
      "key": "content",
      "label": "Contenido",
      "type": "section",
      "hint": "Opcional: filtra lo que sale en búsquedas, Inicio y listas."
    },
    {
      "key": "hideExplicit",
      "label": "Ocultar contenido explícito",
      "type": "toggle",
      "default": false,
      "hint": "Quita canciones y álbumes marcados como explícitos"
    }
  ],
  "browser": true,
  "enhancements": {
    "14": {
      "capabilities": [
        "screen",
        "ai"
      ],
      "screen": {
        "label": "YT Music",
        "labelEn": "YT Music",
        "icon": "music",
        "menuOpens": "both",
        "opensFrom": [
          "menu",
          "settings"
        ],
        "settingsButton": {
          "label": "Abrir YouTube Music",
          "labelEn": "Open YouTube Music"
        }
      },
      "panel": {
        "label": "YT Music",
        "labelEn": "YT Music",
        "icon": "music"
      }
    },
    "19": {
      "panel": {
        "label": "YT Music",
        "labelEn": "YT Music",
        "icon": "music"
      }
    },
    "20": {
      "visualBrowser": true
    }
  }
}
