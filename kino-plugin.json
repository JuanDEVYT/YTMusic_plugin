{
  "id": "ytmusic",
  "name": "YouTube Music",
  "version": "0.3.2",
  "apiVersion": 8,
  "entry": "plugin.js",
  "description": "Busca y reproduce música de YouTube Music; con tu sesión ves tus Me gusta y tus listas",
  "author": "JuanDEVYT",
  "homepage": "https://github.com/JuanDEVYT/YTMusic_plugin",
  "hosts": [
    "music.youtube.com",
    "www.youtube.com",
    "*.googlevideo.com"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve"
  ],
  "color": "#FF3D3D",
  "debug": false,
  "telemetry": false,
  "settings": [
    {
      "key": "account",
      "label": "Tu cuenta de YouTube Music",
      "type": "section",
      "hint": "Opcional. Sin sesión buscas y reproduces como invitado. Con sesión ves tu Inicio personal, tus Me gusta y tus listas. Mira el README para copiar tus cookies en tres partes de máximo 500 caracteres."
    },
    {
      "key": "cookieA",
      "label": "Cookies (parte 1)",
      "type": "password",
      "hint": "Primeros 500 caracteres"
    },
    {
      "key": "cookieB",
      "label": "Cookies (parte 2)",
      "type": "password",
      "hint": "Siguientes 500 caracteres, si hacen falta"
    },
    {
      "key": "cookieC",
      "label": "Cookies (parte 3)",
      "type": "password",
      "hint": "Resto, si hace falta"
    },
    {
      "key": "linked",
      "label": "Estado de la sesión",
      "type": "status"
    },
    {
      "key": "logout",
      "label": "Cerrar sesión",
      "type": "action",
      "confirm": "¿Olvidar las cookies guardadas en todos tus aparatos?"
    },
    {
      "key": "playback",
      "label": "Reproducción",
      "type": "section"
    },
    {
      "key": "quality",
      "label": "Formato de audio",
      "type": "select",
      "default": "aac",
      "options": [
        {
          "value": "aac",
          "label": "AAC (más compatible)"
        },
        {
          "value": "opus",
          "label": "Opus (más calidad)"
        }
      ]
    },
    {
      "key": "method",
      "label": "Método de reproducción",
      "type": "select",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automático (recomendado)"
        },
        {
          "value": "browser",
          "label": "Navegador oculto (experimental)"
        }
      ]
    }
  ],
  "browser": true
}
